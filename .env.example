# Copy to .env and adjust. All settings use the SPLITLEDGER_ prefix.
SPLITLEDGER_ENVIRONMENT=development
SPLITLEDGER_DEBUG=true

# SQLite (default) or Postgres: postgresql+asyncpg://user:pass@localhost:5432/splitledger
SPLITLEDGER_DATABASE_URL=sqlite+aiosqlite:///./splitledger.db

# MUST be overridden outside development. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SPLITLEDGER_JWT_SECRET=dev-insecure-secret-do-not-use-in-production
SPLITLEDGER_ACCESS_TOKEN_TTL_MINUTES=720

SPLITLEDGER_CORS_ORIGINS=["http://localhost:3000"]
